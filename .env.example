# DataReflex environment template — keys and defaults only. Copy to .env and fill secrets.
# Never commit real API keys. See docs/defaults.md for locked defaults.

# LLM (OpenAI-compatible; e.g. Zhipu glm-4-flash-250414)
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash-250414
LLM_TEMPERATURE=0.1
# v2-1/v2-4: Graph LLM assist (GenerateOp / clarify / Reflect / conclusion).
# Default true; without LLM_API_KEY the Graph still falls back to templates.
ENABLE_LLM_OPS=true

# Strategy flags
ENABLE_PLANNER=true
ENABLE_REFLECTOR=true
ENABLE_SANDBOX=true
ENABLE_HUMAN_CONFIRM=true
ENABLE_FALLBACK_REPORT=true

# Limits & timeouts
MAX_RETRY_ROUNDS=3
MAX_LLM_CALLS_PER_TASK=20
PLAN_CONFIRM_TIMEOUT_SECONDS=300
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_CPU_LIMIT=1.0
MAX_UPLOAD_FILES=5
MAX_FILE_SIZE_MB=20

# Sandbox (mock=demo canned rows; docker=one-shot container)
SANDBOX_BACKEND=mock
SANDBOX_IMAGE=data-reflex-sandbox:3.11

# Persistence / logging
SQLITE_PATH=data/data_reflex.db
LOG_LEVEL=INFO

# Langfuse Cloud (optional; leave empty for no-op tracing). V2-7.
# Create keys at https://cloud.langfuse.com — then: python scripts/smoke_langfuse.py
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Leave empty for Langfuse Cloud default host, or set e.g. https://cloud.langfuse.com
LANGFUSE_HOST=

# Eval reproducibility
EVAL_FIXED_CLOCK=2025-10-01T00:00:00+08:00
EVAL_TIMEZONE=Asia/Shanghai

# Context
NEW_TOPIC_RULE=dataset_or_label_change_without_anaphora

# Sensitive fields (comma-separated; override only if needed)
# SENSITIVE_FIELDS=phone,mobile,email,id_card,address,手机,手机号,电话,邮箱,身份证,身份证号,地址
